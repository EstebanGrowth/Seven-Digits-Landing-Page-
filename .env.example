# Copy to .env.local for local development. Never commit real values.

# Public canonical origin, without a trailing slash. Set this once the
# custom domain is connected (used for canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- GoHighLevel / LeadConnector (server-side only, NEVER prefix with NEXT_PUBLIC_) ---
# Private Integration Token for the sub-account (Settings > Private Integrations).
# Required scopes: contacts.write (and contacts.readonly is recommended).
GHL_PRIVATE_INTEGRATION_TOKEN=pit-00000000-0000-0000-0000-000000000000
# Sub-account (Location) ID (Settings > Business Profile).
GHL_LOCATION_ID=ExampleLocationId123
